---
/**
 * ProjectorLayout.astro
 * 
 * The main layout shell for the film projector-themed portfolio.
 * 
 * Structure:
 * - Atmosphere layers (FX plates) sit OUTSIDE/BEHIND the projected screen
 * - Projected screen is the stable reading zone (no FX over text)
 * - Mobile-first responsive design
 */

import Controls from '../components/Controls';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Jiachen's Design Portfolio" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Jiachen Portfolio</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    
    <!-- Prefers reduced motion check -->
    <script is:inline>
      // Check for reduced motion preference early
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce-motion');
      }
    </script>
  </head>
  
  <body class="min-h-screen bg-stage text-text-primary font-body">
    <!-- 
      ATMOSPHERE LAYERS (FX plates go here)
      These sit BEHIND the projected screen, never over body text.
      FX plates will be added in future slices; slots ready for integration.
    -->
    <div class="atmosphere-layers fixed inset-0 pointer-events-none z-0" aria-hidden="true">
      <!-- FX plate slot: background grain/texture -->
      <div class="fx-layer fx-grain"></div>
      
      <!-- FX plate slot: vignette/edge effects -->
      <div class="fx-layer fx-vignette"></div>
      
      <!-- FX plate slot: light leak/projector glow -->
      <div class="fx-layer fx-glow"></div>
    </div>
    
    <!-- 
      PROJECTED SCREEN (main content area)
      This is the stable reading zone. NO layout shift allowed here.
      Headline, subhead, and first paragraph must remain stable.
      Responsive: mobile-first, centered on desktop.
    -->
    <div class="projected-screen relative z-10 mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8 min-h-screen">
      <!-- Main content slot -->
      <main class="screen-content">
        <slot />
      </main>
    </div>
    
    <!-- 
      CONTROLS AREA
      Sound toggle and other controls go here.
    -->
    <div class="controls fixed bottom-4 right-4 z-50">
      <Controls client:load />
    </div>
  </body>
</html>

<style>
  /* 
   * Base styles for the projector layout
   * Most styling handled by Tailwind, this is for FX-specific utilities
   */
  
  .atmosphere-layers {
    isolation: isolate;
  }
  
  .fx-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    /* FX plates will be loaded here in future slices */
  }
  
  /* Placeholder styles - actual FX plates will be added when assets are available
     For now, these slots are prepared but inactive */
  .fx-grain {
    /* Background grain texture slot - will use background-image when asset ready */
  }
  
  .fx-vignette {
    /* Vignette/edge darkening slot - will use background-image when asset ready */
  }
  
  .fx-glow {
    /* Projector light glow slot - will use background-image when asset ready */
  }
  
  /* Reduced motion: disable non-essential animations */
  :global(.reduce-motion) .fx-layer {
    animation: none !important;
    transition: none !important;
  }
  
  /* Projected screen - clear visual structure */
  .projected-screen {
    /* Center the content area - this is the reading zone */
    position: relative;
  }
  
  /* Screen content - stable reading zone */
  .screen-content {
    /* Prevent layout shift */
    min-height: 1px;
    width: 100%;
  }
  
  /* Mobile-first: ensure controls are tappable */
  @media (max-width: 640px) {
    .controls {
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
