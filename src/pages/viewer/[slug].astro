---
/**
 * Viewer page - Case study viewer
 * 
 * This is the case study viewer page that displays individual project content.
 * Enhanced in S6 with Content Collections MDX rendering.
 */

import { getCollection, getEntry } from 'astro:content';
import ProjectorLayout from '../../layouts/ProjectorLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'posts'>>>[0];
}

const { post } = Astro.props;
const { Content } = await post.render();
const baseUrl = import.meta.env.BASE_URL;
---

<ProjectorLayout title={post.data.title} description={post.data.cover || 'Case study'}>
  <article class="space-y-8">
    <header class="space-y-4">
      <h1 class="text-4xl font-bold text-text-primary">{post.data.title}</h1>
      {post.data.cover && (
        <div class="cover-image mt-4">
          <img 
            src={`${baseUrl}/assets/images/${post.data.cover}`} 
            alt={post.data.title}
            class="w-full max-w-2xl rounded-lg"
          />
        </div>
      )}
    </header>

    <!-- Content area -->
    <div class="prose prose-invert prose-neutral max-w-none 
                prose-headings:text-text-primary
                prose-p:text-text-secondary
                prose-a:text-text-primary prose-a:underline hover:prose-a:text-text-primary
                prose-strong:text-text-primary
                prose-code:text-text-primary prose-code:bg-neutral-800 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                prose-img:rounded-lg prose-img:my-8">
      <Content />
    </div>
  </article>
</ProjectorLayout>

<style>
  /* Ensure readability in projected screen */
  .prose {
    color: var(--tw-prose-body);
  }
  
  .prose code {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
</style>
